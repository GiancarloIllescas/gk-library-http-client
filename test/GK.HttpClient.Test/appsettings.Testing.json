{
	// Configuración de tus clientes HTTP
	"HttpClients": {
		"BasicApiClient": {
			"BaseAddress": "https://localhost/",
			"DefaultHeaders": {
				"Accept": "application/json"
			},
			"DefaultTimeout": "00:00:15" // Tiempo de espera por defecto para el HttpClient
		},
		"ResilientBasicApiClient": {
			"BaseAddress": "https://localhost/",
			"DefaultHeaders": {
				"Accept": "application/json"
			},
			"ResiliencePolicyName": "ResilientBasicApiPolicy"
		},
		"ResilientRetryApiClient": {
			"BaseAddress": "https://localhost/",
			"DefaultHeaders": {
				"Accept": "application/json"
			},
			"ResiliencePolicyName": "ResilientRetryApiPolicy"
		},
		"ResilientCircuitBrekerApiClient": {
			"BaseAddress": "https://localhost/",
			"DefaultHeaders": {
				"Accept": "application/json"
			},
			"ResiliencePolicyName": "ResilientCircuitBrekerApiPolicy"
		}
	},

	// Definición de las políticas de resiliencia
	"ResiliencePolicies": {
		"ResilientBasicApiPolicy": {
			"Timeout": {
				"Timeout": "00:00:15"
			}
		},
		"ResilientRetryApiPolicy": {
			"Retry": {
				"MaxRetries": 2,
				"Delay": "00:00:01"
			},
			"Timeout": {
				"Timeout": "00:00:15"
			}
		},
		"ResilientCircuitBrekerApiPolicy": {
			"CircuitBreaker": {
				"FailureRatio": 0.5, //50%
				"MinimumThroughput": 10,
				"SamplingDuration": "00:00:30", //30seg
				"BreakDuration": "00:00:10" //10seg
			},
			"Timeout": {
				"Timeout": "00:00:10"
			}
		}
	}
}